const TerminalState = enum { connecting, connected, reconnecting, busy, disconnected };

var state: *zx.State(TerminalState) = undefined;
var message: *zx.State([]const u8) = undefined;
var session_id: *zx.State([]const u8) = undefined;
var terminal_text: *zx.State([]const u8) = undefined;

pub fn TerminalApp(ctx: *zx.ComponentCtx(void)) zx.Component {
    state = ctx.state(TerminalState, .connecting);
    message = ctx.state([]const u8, "Connecting…");
    session_id = ctx.state([]const u8, "");
    terminal_text = ctx.state([]const u8, "");

    return (
        <section @allocator={ctx.allocator} class="terminal-layout" onload={start}>
            <div class="terminal-toolbar">
                <strong>ghostty-web-server</strong>
                <span class="terminal-status">{message}</span>
                <button onclick={takeSession}>Take session</button>
                <button onclick={refreshSessions}>Sessions</button>
            </div>
            <div id="terminal" class="terminal-surface" tabindex="0" onkeydown={sendKey} onpaste={pasteText}>
                <pre>{terminal_text}</pre>
            </div>
        </section>
    );
}

fn start() void {
    state.set(.connecting);
    message.set("Connecting…");
    frontend.start(session_id, terminal_text, state, message, false);
}

fn takeSession() void {
    frontend.start(session_id, terminal_text, state, message, true);
}

fn refreshSessions() void {
    _ = zx.fetch(.noop, zx.allocator, "/api/sessions", .{}) catch {
        message.set("Failed to refresh sessions");
    };
}

fn sendKey(event: zx.client.Event) void {
    frontend.sendKey(event);
}

fn pasteText(event: zx.client.Event) void {
    frontend.paste(event);
}

const zx = @import("zx");
const frontend = @import("../client/frontend.zig");
